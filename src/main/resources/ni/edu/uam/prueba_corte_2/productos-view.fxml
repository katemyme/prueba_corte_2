<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="680" prefWidth="1000" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.prueba_corte_2.Controller.Producto_Controller">
    <top>
        <VBox spacing="12">
            <padding>
                <Insets bottom="10" left="20" right="20" top="15" />
            </padding>

            <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Catálogo de productos - Papelería Campus" />
            <GridPane hgap="12" vgap="10">
                <columnConstraints>
                    <ColumnConstraints prefWidth="100" />
                    <ColumnConstraints prefWidth="180" />
                    <ColumnConstraints prefWidth="100" />
                    <ColumnConstraints prefWidth="180" />
                </columnConstraints>

                <Label text="Código:" GridPane.rowIndex="1" />
                <TextField fx:id="txtCodigo" promptText="Ej. P001" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label text="Nombre:" GridPane.rowIndex="2" />
                <TextField fx:id="txtNombre" promptText="Nombre del producto" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                <Label text="Categoría:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                <ComboBox fx:id="cmbCategoria" prefWidth="180" promptText="Seleccione" GridPane.columnIndex="3" GridPane.rowIndex="1" />

                <Label text="Precio C$:" GridPane.rowIndex="3" />
                <TextField fx:id="txtPrecio" promptText="0.00" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                <Label text="Stock:" GridPane.columnIndex="2" GridPane.rowIndex="3" />
                <TextField fx:id="txtStock" promptText="0" GridPane.columnIndex="3" GridPane.rowIndex="3" />
            <rowConstraints>
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
            </rowConstraints>
            </GridPane>

            <HBox spacing="8">
                <Button fx:id="btnNuevo" onAction="#Nuevo_producto" text="Limpiar formulario" />
                <Button fx:id="btnGuardar" onAction="#guardar_producto" text="Guardar" />
                <Button fx:id="btnActualizar" onAction="#Actualizar_producto" text="Actualizar" />
                <Button fx:id="btnEliminar" onAction="#Eliminar_producto" text="Eliminar" />
            </HBox>

            <Separator />
            <Label style="-fx-font-size: 15px; -fx-font-weight: bold;" text="Búsqueda y filtros" />

            <GridPane hgap="12" vgap="10">
                <columnConstraints>
                    <ColumnConstraints prefWidth="120" />
                    <ColumnConstraints prefWidth="180" />
                    <ColumnConstraints prefWidth="100" />
                    <ColumnConstraints prefWidth="180" />
                </columnConstraints>

                <Label text="Código o nombre:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <TextField fx:id="txtBuscar" onAction="#Buscar_producto" promptText="Buscar..." GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Label text="Categoría:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                <ComboBox fx:id="cmbFiltroCategoria" prefWidth="180" GridPane.columnIndex="3" GridPane.rowIndex="0" />

                <CheckBox fx:id="chkConExistencias" text="Solo con existencias" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="1" />
            <rowConstraints>
               <RowConstraints />
               <RowConstraints />
            </rowConstraints>
            </GridPane>

            <HBox spacing="8">
                <Button fx:id="btnBuscar" onAction="#Buscar_producto" text="Buscar" />
                <Button fx:id="btnLimpiarFiltros" onAction="#limpiarFiltros" text="Limpiar filtros" />
                <Button fx:id="btnRecargar" onAction="#recargar" text="Recargar" />
            </HBox>
        </VBox>
    </top>
    <center>
        <TableView fx:id="tablaProductos">
            <BorderPane.margin>
                <Insets bottom="5" left="20" right="20" top="5" />
            </BorderPane.margin>

            <placeholder>
                <Label text="Sin coincidencias" />
            </placeholder>

            <columns>
                <TableColumn fx:id="colId" prefWidth="70" text="ID" />
                <TableColumn fx:id="colCodigo" prefWidth="110" text="Código" />
                <TableColumn fx:id="colNombre" prefWidth="280" text="Nombre" />
                <TableColumn fx:id="colCategoria" prefWidth="150" text="Categoría" />
                <TableColumn fx:id="colPrecio" prefWidth="120" text="Precio C$" />
                <TableColumn fx:id="colStock" prefWidth="100" text="Stock" />
            </columns>
        </TableView>
    </center>
    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="20">
            <padding>
                <Insets bottom="15" left="20" right="20" />
            </padding>
            <Label fx:id="lblContador" text="Registros: 0" />
            <Label fx:id="lblEstado" text="" />
        </HBox>
    </bottom>

</BorderPane>
